# Sysmon + Sysinternals Detection Lab .gitignore
# Professional Baseline Configuration

# ==========================================
# Virtual Machine & Hypervisor Files
# ==========================================
*.vdi
*.vmdk
*.vbox
*.vbox-prev
*.nvram
*.log
*.vmx
*.vmxf
*.vmsd
*.ova
*.ovf
Snapshots/
.VirtualBox/
VBoxGuestAdditions_*.iso
.vagrant/

# ==========================================
# Memory Dumps & Large Binary Files
# ==========================================
*.dmp
*.dump
*.mem
*.raw
*.bin
*.hive
*.dat
lsass*.dmp     # Explicitly ignore ProcDump LSASS extractions

# ==========================================
# Windows Event Logs & Trace Captures
# ==========================================
*.evtx
*.evt
*.etl          # Event Trace Logs (ETW)

# Keep sanitized example event logs for documentation
!scenarios/**/sysmon-events.json
!scenarios/**/example-events.evtx
!assets/**/*.evtx

# ==========================================
# Network Captures
# ==========================================
*.pcap
*.pcapng
*.cap

# Keep small example captures for scenario evidence
!scenarios/**/example-traffic.pcap

# ==========================================
# Malware Samples & Offensive Payloads
# ==========================================
*.exe
*.dll
*.scr
*.msi
*.sys
*.ps1.encrypted
malware-samples/
payloads/

# Allow legitimate PowerShell provisioning scripts
!scenarios/**/*.ps1
!tools/**/*.ps1
!setup/**/*.ps1

# ==========================================
# Credentials & Sensitive Data
# ==========================================
*.pfx
*.p12
*.key
*.pem
*.crt
credentials.txt
passwords.txt
secrets/
.env
.env.local

# ==========================================
# Sysinternals Output
# ==========================================
# Process Monitor
*.pml
Logfile.PML

# Autoruns Output (Large CSVs/ARNs)
*-autoruns-full.csv
baseline-*.arn

# Keep baseline and filter configurations
!tools/**/procmon-filters/*.pmc
!tools/baseline-autoruns-example.csv

# ==========================================
# SIEM & Log Aggregation (Wazuh / Elastic)
# ==========================================
elasticsearch/data/
logstash/data/
kibana/data/
wazuh/data/
wazuh/logs/

# Keep custom Wazuh rules and decoders
!wazuh/rules/*.xml
!wazuh/decoders/*.xml

# ==========================================
# Temporary Files & OS Junk
# ==========================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
ntuser.*

# ==========================================
# Archives
# ==========================================
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso

# Keep small documentation or tool archives
!docs/**/*.zip
!tools/**/*.zip

# ==========================================
# Personal Notes, Drafts & Sandboxes
# ==========================================
NOTES.md
TODO.md
scratch/
drafts/
test-data/
sandbox/
temp-analysis/

# ==========================================
# Development, IDE & Editor Files
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vs/
.user
*.suo
*.user
*.userosscache
*.sln.docstates

# ==========================================
# Python Environment (Backend analysis)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.venv/

# ==========================================
# Node/JS Environment (Frontend UI)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Compiled Output
# ==========================================
*.o
*.obj
*.class
bin/
obj/

# ==========================================
# Force Keep Empty Directories
# ==========================================
# Useful to maintain repo structure for logs, assets, and payloads
!.gitkeep
